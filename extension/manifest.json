{
  "manifest_version": 3,
  "name": "Privacy Inspector",
  "version": "0.2.0",
  "description": "Extensão para análise de privacidade, rastreamento e indicadores de segurança em páginas web.",

  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "webRequest",
    "webRequestBlocking"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": [
        "utils.js",
        "filter-engine.js",
        "tracking-detector.js",
        "background.js"
        ]
    },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "page-script.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],

  "action": {
    "default_title": "Privacy Inspector",
    "default_popup": "popup/popup.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-inspector@insper.local",
      "strict_min_version": "128.0"
    }
  }
}
